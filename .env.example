# B.Tech Student Super-Hub — Environment Configuration Template
#
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
#
# ── AI Assistant (optional) ──────────────────────────────────────────────────
# The AI assistant is completely optional.
# If no key is set, the app works normally without it.
#
# Option 1: OpenAI
# OPENAI_API_KEY=sk-...your-key-here...
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
#
# Option 2: Groq (free tier available — very fast)
# GROQ_API_KEY=gsk_...your-key-here...
# AI_PROVIDER=groq
# AI_MODEL=llama3-8b-8192
#
# ── How to load this in your shell ───────────────────────────────────────────
# Linux/macOS:
#   export OPENAI_API_KEY=sk-...
#   streamlit run app.py
#
# Windows PowerShell:
#   $env:OPENAI_API_KEY = "sk-..."
#   streamlit run app.py
#
# Or use python-dotenv:
#   pip install python-dotenv
#   Add `from dotenv import load_dotenv; load_dotenv()` at the top of app.py
